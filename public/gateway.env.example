# Cloudflare Zero Trust -> Access -> Applications -> InfluencerResearch.
# Team domain example: my-team.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com

# Application Audience (AUD) tag for the InfluencerResearch Access application.
ACCESS_AUD=<application-audience-tag>

# Optional. For interactive Managed OAuth, set the exact allowed login email(s),
# comma-separated. Leave empty when policy identity is enforced entirely by
# Cloudflare Access (for example a Service Auth policy).
ACCESS_ALLOWED_EMAILS=

RATE_PER_MIN=120
